msgstr "terminal;prompt;ptyxis;shell;command;commandline;cmd;cli;console;container;podman;toolbox;distrobox;opdrachtregel;gereedschapskist;hulpmiddelen;"

#: data/org.gnome.Ptyxis.desktop.in.in:23
#: src/org.gnome.Ptyxis.gschema.xml.in:424 src/ptyxis-preferences-window.ui:742
msgid "New Window"
msgstr "Nieuw venster"

#: data/org.gnome.Ptyxis.desktop.in.in:27
#: src/org.gnome.Ptyxis.gschema.xml.in:418 src/ptyxis-preferences-window.ui:771
msgid "New Tab"
msgstr "Nieuw tabblad"

#: data/org.gnome.Ptyxis.desktop.in.in:31
#: src/org.gnome.Ptyxis.gschema.xml.in:436 src/ptyxis-preferences-window.ui:978
msgid "Preferences"
msgstr "Voorkeuren"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:7
msgid "Container-oriented terminal"
msgstr "Een op containers gefocuste terminal"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:9
msgid "Ptyxis is a terminal for GNOME that focuses on ease-of-use in a world of containers."
msgstr "Ptyxis is een terminal voor GNOME die zich specialiseert in gebruiksgemak bij het gebruik van containers."

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:13
msgid "Features:"
msgstr "Functies:"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:15
msgid "Remembers current container when opening a new tab with support for podman, toolbox, distrobox, and more"
msgstr "Onthoudt de huidige container bij het openen van een nieuw tabblad, met ondersteuning voor podman, toolbox, distrobox en meer"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:16
msgid "Configurable keyboard shortcuts"
msgstr "Instelbare sneltoetsen"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:17
msgid "Modern interface which integrates the palette with the window styling"
msgstr "Moderne interface die het kleurenpalet integreert met de styling van het venster"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:18
msgid "User-installable color palettes"
msgstr "Door de gebruiker beheerde kleurenpaletten"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:19
msgid "Support for preferences profiles with container integration"
msgstr "Ondersteuning voor voorkeursprofielen met containerintegratie"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:20
msgid "Integrated color palettes with light and dark support"
msgstr "Geïntegreerde lichte en donkere kleurenpaletten"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:21
msgid "Tabbed interface with tab overviews"
msgstr "Interface met tabbladen en tabbladoverzichten"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:22
msgid "Efficient foreground process tracking denoting sudo and SSH"
msgstr "Efficiënte tracking van voorgrondprocessen met indicatoren voor sudo en SSH"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:23
msgid "Support for transparent terminal backgrounds"
msgstr "Ondersteuning voor transparante terminalachtergronden"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:24
msgid "Separate process mode for terminal-based applications"
msgstr "Aparte proces-modus voor terminal-gebaseerde toepassingen"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:25
msgid "Support for pinned tabs and saved sessions"
msgstr "Ondersteuning voor gepinde tabbladen en het opslaan van sessies"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:26
msgid "Terminal tabs are run within separate cgroups"
msgstr "Terminal-tabbladen worden in aparte cgroups gedraaid"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:27
msgid "Terminal inspector to help when writing terminal-based applications"
msgstr "Inspector die helpt bij het schrijven van terminal-gebaseerde toepassingen"

#. developer_name tag deprecated with Appstream 1.0
#: data/org.gnome.Ptyxis.metainfo.xml.in.in:32
msgid "Christian Hergert"
msgstr "Christian Hergert"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:54
msgid "A column and row size indicator is displayed when resizing the window"
msgstr "Een indicator die het aantal kolommen en rijen weergeeft wordt getoond wanneer het venster van grootte verandert"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:59
msgid "Containers are automatically discovered and displayed"
msgstr "Containers worden automatisch ontdekt en weergegeven"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:64
msgid "Many behaviors of the terminal may be tweaked to user preference"
msgstr "Het meeste gedrag van de terminal kan naar voorkeur aangepast worden"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:69
msgid "You may rename a tab by providing a prefix to the title"
msgstr "U kunt tabbladen hernoemen door een prefix aan de titel toe te voegen"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:74
msgid "Palettes provide an integrated dark mode"
msgstr "Kleurenpaletten hebben een geïntegreerde donkere modus"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:79
msgid "You can see an overview of your tabs at any time"
msgstr "U kunt op elk moment een overzicht van uw tabbladen zien"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:84
msgid "Many shortcuts may be remapped to user preference"
msgstr "Veel sneltoetsen kunnen naar voorkeur aangepast worden"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:89
msgid "Built-in color palettes provide both dark and light mode variants"
msgstr "Ingebouwde kleurenpaletten met donkere en lichte varianten"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:94
msgid "Profiles allow for overriding a number of features such as default container"
msgstr "Profielen laten toe om een aantal functies te overschrijven, zoals de standaardcontainer"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:99
msgid "The terminal will remind you when you're root on the local system"
msgstr "De terminal helpt u eraan denken dat u root bent op een lokaal systeem"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:104
msgid "The terminal will remind you when you're on a remote system"
msgstr "De terminal helpt u eraan denken dat u op een ander systeem werkt"

#: src/main.c:142 src/main.c:149 src/main.c:161
msgid "Error"
msgstr "Fout"

#: src/main.c:155
#, c-format
msgid ""
"Error: %s already exists.\n"
"Please remove it first.\n"
msgstr ""
"Fout: %s bestaat reeds.\n"
"Gelieve deze eerst te verwijderen.\n"

#: src/org.gnome.Ptyxis.gschema.xml.in:101
msgid "Default Profile UUID"
msgstr "UUID van standaardprofiel"

#: src/org.gnome.Ptyxis.gschema.xml.in:102
msgid "The UUID of the default profile"
msgstr "De UUID van het standaardprofiel"

#: src/org.gnome.Ptyxis.gschema.xml.in:107
msgid "UUIDs of all Profiles"
msgstr "UUID’s van alle profielen"

#: src/org.gnome.Ptyxis.gschema.xml.in:108
msgid "A list of UUID for every profile"
msgstr "Een lijst van UUID’s, voor elk profiel"

#: src/org.gnome.Ptyxis.gschema.xml.in:113 src/ptyxis-preferences-window.ui:322
msgid "New Tab Position"
msgstr "Positie nieuwe tabbladen"

#: src/org.gnome.Ptyxis.gschema.xml.in:114
msgid "Where to place new tabs"
msgstr "Waar nieuwe tabbladen geplaatst moeten worden"

#: src/org.gnome.Ptyxis.gschema.xml.in:119 src/ptyxis-preferences-window.ui:414
msgid "Audible Bell"
msgstr "Hoorbare bel"

#: src/org.gnome.Ptyxis.gschema.xml.in:120
msgid "If an audible bell should be used"
msgstr "Of een hoorbaar belsignaal gebruikt moet worden"

#: src/org.gnome.Ptyxis.gschema.xml.in:125
msgid "Visible Bell"
msgstr "Zichtbare bel"

#: src/org.gnome.Ptyxis.gschema.xml.in:126
msgid "If a visual bell should be used"
msgstr "Of een visueel belsignaal gebruikt moet worden"

#: src/org.gnome.Ptyxis.gschema.xml.in:131
msgid "Visual Process Leader"
msgstr "Visuele indicator procesleider"

#: src/org.gnome.Ptyxis.gschema.xml.in:132
msgid "Display a visual window highlight when process leader is SSH, sudo, or other specialized tooling"
msgstr "Gebruik een visuele venstermarkering wanneer de procesleider SSH, sudo, of andere gespecialiseerde tooling is"

#: src/org.gnome.Ptyxis.gschema.xml.in:137
msgid "Use System Font"
msgstr "Systeemlettertype gebruiken"

#: src/org.gnome.Ptyxis.gschema.xml.in:138
msgid "If the default system monospace font should be used"
msgstr "Of het standaard systeemlettertype met vaste breedte gebruikt moet worden"

#: src/org.gnome.Ptyxis.gschema.xml.in:143
msgid "Font Name"
msgstr "Lettertypenaam"

#: src/org.gnome.Ptyxis.gschema.xml.in:144
msgid "The font description to use if use-system-font is set to False"
msgstr "De lettertypebeschrijving om te gebruiken als use-system-font uit staat"

#: src/org.gnome.Ptyxis.gschema.xml.in:149 src/ptyxis-preferences-window.ui:249
msgid "Cursor Shape"
msgstr "Cursorvorm"

#: src/org.gnome.Ptyxis.gschema.xml.in:150
msgid "The default shape of the cursor"
msgstr "De standaardvorm van de invoercursor"

#: src/org.gnome.Ptyxis.gschema.xml.in:155
msgid "Cursor Blink Mode"
msgstr "Knippermodus cursor"

#: src/org.gnome.Ptyxis.gschema.xml.in:156
msgid "The default blink mode cursor"
msgstr "De standaardknippermodus van de invoercursor"

#: src/org.gnome.Ptyxis.gschema.xml.in:161
msgid "List of punctuation characters that are treated as word characters"
msgstr "Lijst van interpunctietekens om te behandelen als woordtekens"

#: src/org.gnome.Ptyxis.gschema.xml.in:162
msgid "By default, when doing word-wise selection, most punctuation breaks up word boundaries. This list of exceptions will instead be treated as part of the word."
msgstr "Standaard geldt interpunctie als grens bij woordgebaseerde selecties. Deze lijst van uitzonderingen zullen in plaats daarvan behandeld worden alsof ze deel van het woord uitmaken."

#: src/org.gnome.Ptyxis.gschema.xml.in:167
msgid "Scrollbar Policy"
msgstr "Schuifbalkbeleid"

#: src/org.gnome.Ptyxis.gschema.xml.in:168
msgid "If scrollbars should be displayed"
msgstr "Of schuifbalken getoond moeten worden"

#: src/org.gnome.Ptyxis.gschema.xml.in:177
msgid "Text Blink Mode"
msgstr "Knippermodus tekst"

#: src/org.gnome.Ptyxis.gschema.xml.in:178
msgid "When text blinking is allowed"
msgstr "Of knipperen van tekst toegelaten is"

#: src/org.gnome.Ptyxis.gschema.xml.in:183
msgid "Interface Style"
msgstr "Interfacestijl"

#: src/org.gnome.Ptyxis.gschema.xml.in:184
msgid "If light or dark interface style should be used"
msgstr "Of een lichte of donkere stijl van interface gebruikt moet worden"

#: src/org.gnome.Ptyxis.gschema.xml.in:189 src/ptyxis-preferences-window.ui:351
msgid "Restore Session"
msgstr "Sessie herstellen"

#: src/org.gnome.Ptyxis.gschema.xml.in:190
msgid "Restore tabs from previous session when starting Ptyxis"
msgstr "Herstel tabs van een vorige sessie bij het opstarten"

#: src/org.gnome.Ptyxis.gschema.xml.in:195 src/ptyxis-preferences-window.ui:357
msgid "Restore Window Size"
msgstr "Venstergrootte herstellen"

#: src/org.gnome.Ptyxis.gschema.xml.in:196
msgid "Restore the previous window size when creating new windows"
msgstr "Of de vorige venstergrootte herstelt moet worden bij het openen van nieuwe vensters"

#: src/org.gnome.Ptyxis.gschema.xml.in:206
msgid "Default Column Size"
msgstr "Standaardkolomgrootte"

#: src/org.gnome.Ptyxis.gschema.xml.in:207
#: src/org.gnome.Ptyxis.gschema.xml.in:214
msgid "Default window size when restore-window-size is not true."
msgstr "Standaardvenstergrootte wanneer restore-window-size uit staat."

#: src/org.gnome.Ptyxis.gschema.xml.in:213
msgid "Default Row Size"
msgstr "Standaardrijgrootte"

#: src/org.gnome.Ptyxis.gschema.xml.in:219
msgid "Toast on Copy Clipboard"
msgstr "Notificatie bij Naar klembord kopiëren"

#: src/org.gnome.Ptyxis.gschema.xml.in:220
msgid "Show the user when text has copied to the clipboard."
msgstr "Informeer de gebruiker wanneer tekst naar het klembord gekopieerd werd."

#: src/org.gnome.Ptyxis.gschema.xml.in:225
msgid "Enable Accessibility"
msgstr "Toegankelijkheid inschakelen"

#: src/org.gnome.Ptyxis.gschema.xml.in:226
msgid "Currently experimental feature to send accessibility information to screen readers."
msgstr "Experimentele functie waardoor toegankelijkheidsinformatie naar schermlezers gestuurd wordt."

#: src/org.gnome.Ptyxis.gschema.xml.in:231
msgid "Enable zoom on scroll holding the control key"
msgstr "Ctrl+scrollen om te zoomen inschakelen"

#: src/org.gnome.Ptyxis.gschema.xml.in:232
msgid "Enable to adjust the zoom level on scroll scroll while holding the control key."
msgstr "Indien ingeschakeld past scrollen met de Control-toets ingedrukt het zoomniveau aan."

#: src/org.gnome.Ptyxis.gschema.xml.in:237
msgid "Disable Padding around Terminal Emulator"
msgstr "Witruimte rond terminalemulator uitschakelen"

#: src/org.gnome.Ptyxis.gschema.xml.in:238
msgid "Do not pad around the terminal emulator widget. Setting to true may have significant performance impacts."
msgstr "Plaats geen witruimte rond de terminalemulatorwidget. Dit inschakelen kan een nefaste impact op performantie hebben."

#: src/org.gnome.Ptyxis.gschema.xml.in:243
msgid "Prompt when active tab is closed"
msgstr "Bevestiging vragen bij sluiten actieve tab"

#: src/org.gnome.Ptyxis.gschema.xml.in:244
msgid "If a tab (or window) is closed with active foreground processes, prompt the user for confirmation."
msgstr "Vraag bevestiging alvorens het actieve tabblad (of venster) te sluiten wanneer er voorgrondprocessen actief zijn."

#. Translators: OSC stands for "Operating System Command" and is referencing in-band escape sequences from the child process to set the title
#: src/org.gnome.Ptyxis.gschema.xml.in:250
msgid "Ignore OSC Title"
msgstr "OSC-titel negeren"

#: src/org.gnome.Ptyxis.gschema.xml.in:251
msgid "If OSC title should be ignored in tab titles."
msgstr "Of de OSC-titel genegeerd dient te worden in titels van tabbladen."

#: src/org.gnome.Ptyxis.gschema.xml.in:256
msgid "Inhibit Logout"
msgstr "Logout verhinderen"

#: src/org.gnome.Ptyxis.gschema.xml.in:257
msgid "Inhibit desktop logout when a foreground process is running in a tab."
msgstr "Verhinder het uitloggen op de desktop wanneer er voorgrondprocessen actief zijn in een tabblad."

#: src/org.gnome.Ptyxis.gschema.xml.in:266
msgid "Label"
msgstr "Label"

#: src/org.gnome.Ptyxis.gschema.xml.in:267
msgid "The label for the profile"
msgstr "Het label van het profiel"

#: src/org.gnome.Ptyxis.gschema.xml.in:272
msgid "Login Shell"
msgstr "Inlog-shell"

#: src/org.gnome.Ptyxis.gschema.xml.in:273
msgid "Use a login shell"
msgstr "Of een inlog-shell gebruikt moet worden"

#: src/org.gnome.Ptyxis.gschema.xml.in:278 src/ptyxis-preferences-window.ui:482
#: src/ptyxis-profile-editor.ui:333
msgid "Limit Scrollback"
msgstr "Terugscrollen beperken"

#: src/org.gnome.Ptyxis.gschema.xml.in:279
msgid "Limit the number of lines to keep for scrollback"
msgstr "Beperk het aantal regels dat bijgehouden wordt om terug te scrollen"

#: src/org.gnome.Ptyxis.gschema.xml.in:285 src/ptyxis-preferences-window.ui:491
#: src/ptyxis-profile-editor.ui:342
msgid "Scrollback Lines"
msgstr "Aantal terugscrolregels"

#: src/org.gnome.Ptyxis.gschema.xml.in:286
msgid "The number of lines to keep in the scrollback, zero for no scrollback"
msgstr "Het aantal regels om bij te houden om terug te kunnen scrollen"

#: src/org.gnome.Ptyxis.gschema.xml.in:291 src/ptyxis-preferences-window.ui:472
#: src/ptyxis-profile-editor.ui:323
msgid "Scroll on Output"
msgstr "Scrollen bij uitvoer"

#: src/org.gnome.Ptyxis.gschema.xml.in:292
msgid "Scroll to the bottom upon new output"
msgstr "Scrol automatisch naar de laatste uitvoer zodra er nieuwe uitvoer verschijnt"

#: src/org.gnome.Ptyxis.gschema.xml.in:297 src/ptyxis-preferences-window.ui:466
#: src/ptyxis-profile-editor.ui:317
msgid "Scroll on Keystroke"
msgstr "Scrollen bij toetsaanslag"

#: src/org.gnome.Ptyxis.gschema.xml.in:298
msgid "Scroll to the bottom upon user keystroke"
msgstr "Scrol automatisch naar de laatste uitvoer zodra een toets ingedrukt wordt"

#: src/org.gnome.Ptyxis.gschema.xml.in:303 src/ptyxis-profile-editor.ui:187
msgid "Use Custom Command"
msgstr "Aangepaste opdracht gebruiken"

#: src/org.gnome.Ptyxis.gschema.xml.in:304
msgid "If a custom command should be used"
msgstr "Of een aangepaste opdracht gebruikt moet worden bij het opstarten"

#: src/org.gnome.Ptyxis.gschema.xml.in:309
msgid "Use Proxy"
msgstr "Proxy gebruiken"

#: src/org.gnome.Ptyxis.gschema.xml.in:310
msgid "Apply proxy settings from the host in the container"
msgstr "Proxy-instellingen van host op container toepassen"

#: src/org.gnome.Ptyxis.gschema.xml.in:315 src/ptyxis-profile-editor.ui:192
msgid "Custom Command"
msgstr "Aangepaste opdracht"

#: src/org.gnome.Ptyxis.gschema.xml.in:316
msgid "A custom command for the shell"
msgstr "Een aangepaste opdracht om uit te voeren"

#: src/org.gnome.Ptyxis.gschema.xml.in:321 src/ptyxis-profile-editor.ui:211
msgid "Default Container"
msgstr "Standaardcontainer"

#: src/org.gnome.Ptyxis.gschema.xml.in:322
msgid "The default container to run the command in"
msgstr "De standaardcontainer om de opdracht in te starten"

#: src/org.gnome.Ptyxis.gschema.xml.in:327 src/ptyxis-profile-editor.ui:220
msgid "Preserve Container"
msgstr "Container behouden"

#: src/org.gnome.Ptyxis.gschema.xml.in:328
msgid "Preserve the active container when creating new tabs and windows"
msgstr "Behoud de actieve container bij het aanmaken van nieuwe tabbladen en vensters"

#: src/org.gnome.Ptyxis.gschema.xml.in:333 src/ptyxis-preferences-window.ui:551
#: src/ptyxis-profile-editor.ui:281
msgid "Exit Action"
msgstr "Actie bij afsluiten"

#: src/org.gnome.Ptyxis.gschema.xml.in:334
msgid "The action to take when the shell exits"
msgstr "De actie om te nemen als de shell afsluit"

#: src/org.gnome.Ptyxis.gschema.xml.in:339
msgid "Preserve Directory"
msgstr "Map behouden"

#: src/org.gnome.Ptyxis.gschema.xml.in:340
msgid "If the directory should be preserved for new terminals"
msgstr "Of de map behouden moet blijven voor nieuwe terminals"

#: src/org.gnome.Ptyxis.gschema.xml.in:345 src/ptyxis-inspector.ui:102
#: src/ptyxis-preferences-window.ui:40 src/ptyxis-profile-editor.ui:65
msgid "Palette"
msgstr "Kleurenpalet"

#: src/org.gnome.Ptyxis.gschema.xml.in:346
msgid "The color palette to use for the profile, by name"
msgstr "De naam van het kleurenpalet om te gebruiken voor het profiel"

#: src/org.gnome.Ptyxis.gschema.xml.in:352
msgid "Opacity"
msgstr "Opaciteit"

#: src/org.gnome.Ptyxis.gschema.xml.in:353
msgid "The opacity of the palette background"
msgstr "De opaciteit van de achtergrond uit het kleurenpalet"

#: src/org.gnome.Ptyxis.gschema.xml.in:358
msgid "Bold is Bright"
msgstr "Vet is helder"

#: src/org.gnome.Ptyxis.gschema.xml.in:359
msgid "Setting bold on one of the lower 8 colors in the palette will use bright variant (upper 8 colors)"
msgstr "Het instellen van vet op één van de lagere acht kleuren in het kleurenpalet zal de heldere variant gebruiken (bovenste acht kleuren)"

#: src/org.gnome.Ptyxis.gschema.xml.in:365 src/ptyxis-preferences-window.ui:175
#: src/ptyxis-profile-editor.ui:143
msgid "Line Spacing"
msgstr "Regelspatiëring"

#: src/org.gnome.Ptyxis.gschema.xml.in:366
msgid "The terminal’s cell height scale"
msgstr "De schaal van de hoogte van een cel in de terminal"

#: src/org.gnome.Ptyxis.gschema.xml.in:372 src/ptyxis-preferences-window.ui:189
#: src/ptyxis-profile-editor.ui:157
msgid "Column Spacing"
msgstr "Kolomspatiëring"

#: src/org.gnome.Ptyxis.gschema.xml.in:373
msgid "The terminal’s cell width scale"
msgstr "De schaal van de breedte van een cel in de terminal"

#: src/org.gnome.Ptyxis.gschema.xml.in:378
msgid "CJK Ambiguous Width"
msgstr "Onduidelijke breedte CJK"

#: src/org.gnome.Ptyxis.gschema.xml.in:379
msgid "The size to apply to ambiguous width characters"
msgstr "De grootte om toe te passen op tekens met onduidelijke breedte"

#: src/org.gnome.Ptyxis.gschema.xml.in:384
#: src/org.gnome.Ptyxis.gschema.xml.in:390
msgid "Backspace Binding"
msgstr "Backspacewerking"

#: src/org.gnome.Ptyxis.gschema.xml.in:385
#: src/org.gnome.Ptyxis.gschema.xml.in:391
msgid "What to send to the PTY when a backspace is entered"
msgstr "Wat te sturen naar de PTY als backspace gebruikt wordt"

#: src/org.gnome.Ptyxis.gschema.xml.in:396 src/ptyxis-preferences-window.ui:634
#: src/ptyxis-profile-editor.ui:409
msgid "Custom Links"
msgstr "Aangepaste verwijzingen"

#: src/org.gnome.Ptyxis.gschema.xml.in:397
msgid "A list of custom hyperlinks, each defined by a regular expression matching the text, and a replacement pattern"
msgstr "Een lijst van aangepaste verwijzingen, elk gedefinieerd door een reguliere expressie die de tekst matcht samen met een vervangingspatroon"

#: src/org.gnome.Ptyxis.gschema.xml.in:406 src/ptyxis-preferences-window.ui:672
msgid "Copy to Clipboard"
msgstr "Naar klembord kopiëren"

